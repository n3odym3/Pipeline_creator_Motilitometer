{
    "video_extensions": [
        ".mp4",
        ".mov",
        ".avi",
        ".mkv",
        ".webm",
        ".m4v"
    ],
    "status_rules": [
        {
            "name": "processed",
            "regex": "^[filename]\\.processed$",
            "color": [100, 255, 100, 255],
            "skip_unless_reprocess": true
        },
        {
            "name": "drift",
            "regex": "^[filename]_drift\\.csv$",
            "color": [100, 180, 255, 255],
            "skip_unless_reprocess": false
        }
    ]
}
